{
  "targets": "chrome >= 91, edge >= 91, firefox >= 89, safari >= 16.4, node >= 22.12",
  "presets": [
    "@babel/preset-env"
  ],
  "env": {
    "cjs": {
      "presets": [
        "@babel/preset-env"
      ],
      "plugins": [
        "./scripts/babel-import-extensions.cjs",
        "@babel/plugin-transform-modules-commonjs"
      ]
    },
    "esm": {
      "presets": [
        [
          "@babel/preset-env",
          {
            "modules": false
          }
        ]
      ],
      "plugins": [
        "./scripts/babel-import-extensions.cjs"
      ]
    }
  }
}
